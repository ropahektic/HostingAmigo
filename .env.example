WORMNET_HOST=
WORMNET_PORT=6667
WORMNET_PASSWORD=
WORMNET_NICK=Rbot
WORMNET_USERNAME=rbot
WORMNET_REALNAME=WormNETBot host bot
WORMNET_CHANNELS=#AnythingGoes
WORMNET_COMMAND_PREFIX=!
WORMNET_REPLY_TARGET=private
WORMNET_RECONNECT_SECONDS=5
WORMNET_LOG_LEVEL=INFO
WORMNET_WEB_BASE_URL=
WORMNET_GAME_CHANNEL=#AnythingGoes
WORMNET_GAME_HOST_IP=
WORMNET_GAME_LOCATION=49
WORMNET_GAME_TYPE=0
WORMNET_GAME_BIND_HOST=0.0.0.0
WORMNET_GAME_PORT=17011
# minimal = load sync + loading-done only (2+ humans desync). gameplay = relay C2 until end-of-round (default).
WORMNET_GAME_C2_RELAY=gameplay
# Last dword of WA 0x1C start packet; 500 = 0x1F4 for 3.8.x (wrong value → peer load / Windows error).
WORMNET_WA_START_GAME_VERSION=500
# Path readable on RBot host; OpenWA on VM101 sets RBOT_WINNER_SIDECAR_PATH to the same file (NFS/share).
WORMNET_OPENWA_WINNER_PATH=
